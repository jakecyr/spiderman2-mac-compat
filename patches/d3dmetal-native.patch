+// Local Wine compatibility: older D3DMetal exposes only IDXGIResource.
+class WineResource1 final : public IDXGIResource1 {
+    std::atomic<ULONG> refs{1};
+    IDXGIResource* base;
+public:
+    explicit WineResource1(IDXGIResource* b):base(b) {}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** out) override {
+        if (!out) return E_POINTER;
+        if (dmn_iid_eq(id,__uuidof(IDXGIResource1))) { *out=this; AddRef(); return S_OK; }
+        return base->QueryInterface(id,out);
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return ++refs; }
+    ULONG STDMETHODCALLTYPE Release() override { ULONG n=--refs; if(!n){base->Release();delete this;}return n; }
+    HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID g,UINT n,const void*p) override {return base->SetPrivateData(g,n,p);}
+    HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID g,const IUnknown*p) override {return base->SetPrivateDataInterface(g,p);}
+    HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID g,UINT*n,void*p) override {return base->GetPrivateData(g,n,p);}
+    HRESULT STDMETHODCALLTYPE GetParent(REFIID g,void**p) override {return base->GetParent(g,p);}
+    HRESULT STDMETHODCALLTYPE GetDevice(REFIID g,void**p) override {return base->GetDevice(g,p);}
+    HRESULT STDMETHODCALLTYPE GetSharedHandle(HANDLE*p) override {return hook_GetSharedHandle(base,p);}
+    HRESULT STDMETHODCALLTYPE GetUsage(DXGI_USAGE*p) override {return base->GetUsage(p);}
+    HRESULT STDMETHODCALLTYPE SetEvictionPriority(UINT p) override {return base->SetEvictionPriority(p);}
+    HRESULT STDMETHODCALLTYPE GetEvictionPriority(UINT*p) override {return base->GetEvictionPriority(p);}
+    HRESULT STDMETHODCALLTYPE CreateSubresourceSurface(UINT,IDXGISurface2**p) override {if(p)*p=nullptr;return E_NOTIMPL;}
+    HRESULT STDMETHODCALLTYPE CreateSharedHandle(const SECURITY_ATTRIBUTES*,DWORD,const WCHAR*,HANDLE*out) override {
+        if(SUCCEEDED(return_texture_pod(base,out,true)) || SUCCEEDED(return_buffer_pod(base,out,true)))return S_OK;
+        if(out)*out=nullptr;return E_FAIL;
+    }
+};
