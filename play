#!/bin/bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mode="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$mode" in
  flat|highball|vr) exec /usr/bin/python3 "$root/scripts/launch.py" "$mode" "$@" ;;
  quest) exec /usr/bin/python3 "$root/scripts/launch.py" vr --render third --quest "$@" ;;
  mono) exec /usr/bin/python3 "$root/scripts/launch.py" vr --render mono "$@" ;;
  stereo) exec /usr/bin/python3 "$root/scripts/launch.py" vr --render third "$@" ;;
  check)
    /usr/bin/python3 "$root/scripts/launch.py" flat --check
    exec /usr/bin/python3 "$root/scripts/launch.py" vr --check ;;
  help|-h|--help)
    printf '%s\n' 'Usage: ./play {flat|highball|vr|mono|stereo|quest|check}' '  flat      Original non-VR game via CrossOver' '  highball  Original non-VR game via Highball' '  vr        VR with saved settings' '  mono      VR without stereo depth' '  stereo    VR with the previous 1/3-rate stereo setting' '  quest     Experimental Quest controls with stereo VR' '  check     Validate CrossOver and VR paths without launching' ;;
  *) printf 'Unknown mode: %s\n' "$mode" >&2; exit 2 ;;
esac
